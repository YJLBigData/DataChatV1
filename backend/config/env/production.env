# 服务器执行环境配置（APP_ENV=production 时自动加载）
# 业务库走服务器 MySQL；用户与权限走服务器本地 SQLite。 本文件只含非敏感默认值，可入库。
# 真实连接串/密钥(DB_HOST/DB_USER/DB_PASSWORD/AES_KEY/JWT_SECRET) 只允许出现在
# 服务器本地 /opt/datachatv1/.env（部署脚本写入，chmod 600，禁止入 Git）。
# 部署脚本会 `set -a; source /opt/datachatv1/.env`，真实环境变量优先级最高，覆盖本文件。

APP_ENV=production
APP_DEBUG=false

# —— 服务器 MySQL（业务库 hs_poc，只读查询）——
DB_PORT=3306
DB_NAME=hs_poc
# DB_HOST / DB_USER / DB_PASSWORD 来自 /opt/datachatv1/.env（真实值，不入库）

# 用户体系：服务器本地 SQLite，绝不依赖业务库建 users 表。
USER_DIRECTORY=local
DB_USERS_ENABLED=0
DATACHAT_AUTH_DB=/opt/datachatv1/logs/user_store.db
DATACHAT_PERMISSIONS_DB=/opt/datachatv1/logs/user_store.db

# 公司统一大模型网关（非敏感参数；AES_KEY 来自 /opt/datachatv1/.env）
LLM_PROVIDER=feihe
# 说明：测试与生产为**同一套**飞鹤大模型网关（无本质区别），下面这个地址即生产可用地址，
# 配额按公司网关上限使用。若将来切换到独立生产网关，在 /opt/datachatv1/.env 用真实地址
# 覆盖本行即可（os.environ 优先级最高，覆盖本文件）。
FEIHE_AGENT_API_URL=https://adp-test.feihe.com/adp-engine/v1/agent/chat
FEIHE_SERVICE_OPEN_ID=data_middle_platform
FEIHE_AUTHENTICATOR=AES
FEIHE_AGENT_CODE=kaier_znws
FEIHE_TENANT_CODE=data_middle_platform
FEIHE_CHANNEL=d2b-order
FEIHE_AGENT_DEBUG=true

DATACHAT_REDIS_URL=redis://127.0.0.1:6379/2

# —— 问数准确率参数（详见 docs/ACCURACY_PLAYBOOK.md，按需取消注释覆盖默认）——
# 超范围拒答的检索分数阈值（0=关闭低分拒答；显式点名域外指标的拒答不受影响）
# DATACHAT_SCOPE_REJECT_THRESHOLD=0.35
# 用户域表数 ≤ 该值时 planner 全量呈现表卡片（选表不依赖召回命中）
# DATACHAT_FULL_TABLE_CARDS_MAX=20
# top-2 指标候选分差小于该值触发强制澄清（0=关闭）
# DATACHAT_AMBIGUITY_GAP=0.10
# 采纳样例库（few-shot 飞轮）路径
# DATACHAT_FEWSHOT_DB=/opt/datachatv1/logs/fewshots.db

# 上线务必在 /opt/datachatv1/.env 用真实前端域名覆盖
CORS_ALLOW_ORIGINS=

# Quick BI 智能小Q独立部署 OpenAPI。真实 API_KEY/API_SECRET/USER_TOKEN 只写入
# /opt/datachatv1/.env 或部署脚本外部 smartq.env，禁止提交 Git。
SMARTQ_ENABLED=0
SMARTQ_SERVER_DOMAIN=https://quickbi.feihe.com
SMARTQ_API_BASE=
SMARTQ_TIMEOUT_SECONDS=30

# ============================================================================
# 容量 / 稳定性调优（30 人 × 200/天，4C/8GB；详见 deploy/README.md）。
# 这些都有等价的代码默认值，列在这里是为了运维可见 + 一处可调。
# ============================================================================
# 问数线程池（SSE 经 run_in_executor 落到事件循环默认池；4 核默认仅 ~8，放大到 32）
CHAT_THREAD_POOL_SIZE=32
# anyio 线程限额（同步端点 /api/chat 走这个池，与上面对齐）
ANYIO_THREAD_LIMIT=32
# 全局在途问数上限：超过即 429 泄洪
CHAT_MAX_INFLIGHT=30
# 拿不到名额时的最长等待（秒），超时即 429
CHAT_SEMAPHORE_ACQUIRE_TIMEOUT=0.2

# 业务库连接池（应用侧最大连接 = pool_size + max_overflow = 35，须 ≤ DBA 配额）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# LLM 网关超时/重试（读超时收紧到 90s，避免慢调用长时间钉死线程）
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=90
LLM_MAX_RETRIES=1
